# Terraform directories
.terraform/
.terraform.lock.hcl.backup

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform plan files
*.tfplan
*.plan
plan.out
tfplan

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example
!terraform.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# Terraform CLI config files
.terraformrc
terraform.rc

# Sensitive local files
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
*.env
.env
.env.*

# AWS credentials or local config
.aws/
credentials
config

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo

# Python cache if helper scripts are added
__pycache__/
*.pyc
.venv/
venv/

# Node dependencies if frontend or tooling is added
node_modules/

# Backup files
*.bak
*.tmp
*.backup
